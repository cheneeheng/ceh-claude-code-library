{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"${CLAUDE_PLUGIN_ROOT}/scripts/sync-agents-workspace.py\" start",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"${CLAUDE_PLUGIN_ROOT}/scripts/sync-agents-workspace.py\" start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"${CLAUDE_PLUGIN_ROOT}/scripts/sync-agents-workspace.py\" commit",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"${CLAUDE_PLUGIN_ROOT}/scripts/sync-agents-workspace.py\" end",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"${CLAUDE_PLUGIN_ROOT}/scripts/branch-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
